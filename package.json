{
  "name": "hh-jianpu",
  "version": "0.8.9",
  "private": true,
  "description": "A web-based dynamic numbered musical notation (jianpu) editor with AI-powered image recognition",
  "scripts": {
    "dev": "node scripts/dev.mjs web",
    "build": "pnpm build:shared && pnpm --filter @hh-jianpu/web build && pnpm --filter @hh-jianpu/minitool build",
    "build:core": "pnpm --filter @hh-jianpu/core build",
    "build:web": "pnpm build:shared && pnpm --filter @hh-jianpu/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "release": "./scripts/release.sh",
    "build:shared": "node scripts/build-shared.mjs",
    "dev:minitool": "node scripts/dev.mjs minitool",
    "build:minitool": "pnpm build:shared && pnpm --filter @hh-jianpu/minitool build",
    "probe:minitool": "pnpm --filter @hh-jianpu/minitool exec vite build --mode probe",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "audit:minitool": "node scripts/audit-minitool.mjs",
    "package:minitool": "pnpm build:minitool && node scripts/package-minitool.mjs",
    "dev:web": "node scripts/dev.mjs web",
    "dev:all": "node scripts/dev.mjs all"
  },
  "keywords": [
    "jianpu",
    "numbered-musical-notation",
    "music",
    "sheet-music"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.72.0",
    "acorn": "^8.15.0"
  }
}
