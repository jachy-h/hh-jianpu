    "test": "vitest run",
    "lint": "eslint src/",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
