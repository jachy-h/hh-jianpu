{
  "name": "@hh-jianpu/core",
  "version": "0.7.6",
  "description": "Core library for parsing, rendering, and playing numbered musical notation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
